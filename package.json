{
  "name": "deploypilot",
  "version": "1.0.0",
  "description": "Profile-based FTP, FTPS and SFTP deployment manager for Windows",
  "private": false,
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "npm run lint && npm test && electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "electron-log": "^5.4.3",
    "electron-store": "^10.1.0",
    "extract-zip": "^2.0.1",
    "ignore": "^7.0.5",
    "ssh2-sftp-client": "^12.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "electron": "45.4.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.notmohammadxm.deploypilot",
    "productName": "DeployPilot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!src/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DeployPilot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeployPilot",
      "uninstallDisplayName": "DeployPilot",
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "Mohammad XM"
}
